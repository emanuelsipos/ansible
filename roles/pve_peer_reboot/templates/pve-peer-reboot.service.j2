[Unit]
Description=Safely reboot one PVE node after a controlled update
After=network-online.target pve-cluster.service corosync.service pvedaemon.service pveproxy.service pvestatd.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart={{ pve_peer_reboot_script_path }}
TimeoutStartSec=5m
User=root
Group=root
StandardOutput=journal
StandardError=journal
UMask=0077
