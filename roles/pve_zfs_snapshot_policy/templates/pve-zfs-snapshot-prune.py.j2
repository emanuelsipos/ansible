#!/usr/bin/python3
"""Report or prune policy-managed zfs-auto-snapshot snapshots."""

import argparse
import fcntl
import hashlib
import json
import os
import subprocess
import sys


TIERS = json.loads(r'''{{ pve_zfs_snapshot_policy_tiers | to_json }}''')
PROFILES = json.loads(r'''{{ pve_zfs_snapshot_policy_profiles | to_json }}''')
POLICY_ROOTS = json.loads(r'''{{ _pve_zfs_snapshot_policy_datasets | to_json }}''')
ZFS = {{ pve_zfs_snapshot_policy_zfs_executable | to_json }}
ZPOOL = {{ pve_zfs_snapshot_policy_zpool_executable | to_json }}
PREFIX = {{ pve_zfs_snapshot_policy_prefix | to_json }}
REPORT_LIMIT = {{ pve_zfs_snapshot_policy_report_limit }}
LOCK_FILE = {{ pve_zfs_snapshot_policy_prune_lock_file | to_json }}
SCAN_LOCK_FILE = {{ pve_zfs_snapshot_policy_scan_lock_file | to_json }}


def profile_for(dataset):
    matches = [
        root
        for root in POLICY_ROOTS
        if dataset == root or dataset.startswith(root + "/")
    ]
    if not matches:
        return None
    root = max(matches, key=lambda value: (value.count("/"), len(value)))
    return PROFILES[POLICY_ROOTS[root]]


def snapshots():
    result = subprocess.run(
        [ZFS, "list", "-H", "-p", "-t", "snapshot", "-o", "name,creation"],
        check=True,
        capture_output=True,
        text=True,
    )
    groups = {}
    for line in result.stdout.splitlines():
        full_name, creation_text = line.split("\t", 1)
        if "@" not in full_name:
            continue
        dataset, snapshot = full_name.split("@", 1)
        profile = profile_for(dataset)
        if profile is None:
            continue
        for tier in sorted(TIERS, key=len, reverse=True):
            if snapshot.startswith(f"{PREFIX}_{tier}-"):
                groups.setdefault((dataset, tier), []).append(
                    (int(creation_text), full_name, profile[tier])
                )
                break
    return groups


def candidates():
    found = []
    for (_, tier), entries in snapshots().items():
        entries.sort(reverse=True)
        keep = int(TIERS[tier]["keep"]) if entries[0][2] else 0
        found.extend(entries[keep:])
    return sorted(found)


def scan_blockers(found):
    pools = sorted(
        {
            snapshot.split("@", 1)[0].split("/", 1)[0]
            for _, snapshot, _ in found
        }
    )
    blockers = []
    for pool in pools:
        result = subprocess.run(
            [ZPOOL, "status", "-jp", pool], capture_output=True, text=True
        )
        if result.returncode != 0:
            blockers.append((pool, "inspection_failed", result.stderr.strip()))
            continue
        try:
            scan = json.loads(result.stdout)["pools"][pool].get("scan_stats", {})
            function = str(scan.get("function", "NONE")).upper()
            state = str(scan.get("state", "NONE")).upper()
        except (json.JSONDecodeError, KeyError, TypeError, ValueError) as error:
            blockers.append((pool, "inspection_failed", str(error)))
            continue
        if function in {"SCRUB", "RESILVER"} and state in {
            "SCANNING",
            "PAUSED",
            "IN_PROGRESS",
        }:
            blockers.append((pool, "active_scan", f"{function}:{state}"))
    return blockers


def manifest_sha256(found):
    names = "".join(f"{snapshot}\n" for _, snapshot, _ in found)
    return hashlib.sha256(names.encode("utf-8")).hexdigest()


def main():
    parser = argparse.ArgumentParser()
    action = parser.add_mutually_exclusive_group()
    action.add_argument("--execute", action="store_true")
    action.add_argument("--preflight", action="store_true")
    parser.add_argument("--expect-manifest-sha256")
    args = parser.parse_args()

    os.makedirs(os.path.dirname(LOCK_FILE), mode=0o755, exist_ok=True)
    lock = open(LOCK_FILE, "w", encoding="ascii")  # noqa: SIM115
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        print("another prune operation is active; skipping")
        return

    found = candidates()

    for _, snapshot, _ in found[:REPORT_LIMIT]:
        print(f"candidate={snapshot}")
    if len(found) > REPORT_LIMIT:
        print(f"omitted_candidates={len(found) - REPORT_LIMIT}")
    print(f"candidate_count={len(found)}")
    print(f"candidate_manifest_sha256={manifest_sha256(found)}")

    if (
        args.expect_manifest_sha256
        and args.expect_manifest_sha256 != manifest_sha256(found)
    ):
        print("manifest_mismatch=true", file=sys.stderr)
        raise SystemExit(1)

    destroyed = 0
    failed = 0
    if args.execute or args.preflight:
        scan_lock = open(SCAN_LOCK_FILE, "w", encoding="ascii")  # noqa: SIM115
        try:
            fcntl.flock(scan_lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            print("scan_lock_unavailable=true", file=sys.stderr)
            raise SystemExit(1)

        blockers = scan_blockers(found)
        for pool, reason, detail in blockers:
            print(f"skipped_pool={pool}:{reason}:{detail}")
        blocked_pools = {pool for pool, _, _ in blockers}
        selected = [
            entry
            for entry in found
            if entry[1].split("@", 1)[0].split("/", 1)[0] not in blocked_pools
        ]
        print(f"skipped_candidate_count={len(found) - len(selected)}")

        for _, snapshot, _ in selected:
            result = subprocess.run(
                [ZFS, "destroy", "-n", snapshot], capture_output=True, text=True
            )
            if result.returncode != 0:
                failed += 1
                print(f"preflight_failed={snapshot}", file=sys.stderr)
                sys.stderr.write(result.stderr)

        if failed:
            print(f"destroyed_count={destroyed}")
            print(f"failed_count={failed}")
            raise SystemExit(1)

        print(f"preflight_count={len(selected)}")

        if args.preflight:
            print(f"destroyed_count={destroyed}")
            print(f"failed_count={failed}")
            return

        for _, snapshot, _ in selected:
            result = subprocess.run(
                [ZFS, "destroy", snapshot], capture_output=True, text=True
            )
            if result.returncode == 0:
                destroyed += 1
            else:
                failed += 1
                print(f"failed={snapshot}", file=sys.stderr)
                sys.stderr.write(result.stderr)
                break
    print(f"destroyed_count={destroyed}")
    print(f"failed_count={failed}")
    if failed:
        raise SystemExit(1)


if __name__ == "__main__":
    main()
