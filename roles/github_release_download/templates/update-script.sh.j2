#!/bin/bash
# Auto-generated by github_release_download Ansible role
# Downloads a release asset if a newer version exists

set -euo pipefail

REPO={{ github_release_download_repo | quote }}
ASSET={{ github_release_download_asset | quote }}
DEST={{ github_release_download_dest | quote }}
VERSION_FILE={{ (github_release_download_dest ~ '.ver') | quote }}
FILE_MODE={{ github_release_download_mode | quote }}
{% if github_release_download_owner is defined %}
FILE_OWNER={{ (github_release_download_owner | string) | quote }}
{% endif %}
{% if github_release_download_group is defined %}
FILE_GROUP={{ (github_release_download_group | string) | quote }}
{% endif %}
LOG_FILE={{ github_release_download_cron_log_file | quote }}
TOKEN_FILE={{ github_release_download_token_file | quote }}
API_BASE={{ github_release_download_api_url | quote }}
API_ORIGIN={{ github_release_download_api_origin | quote }}
RELEASE_PATH={{ (
    'tags/' ~ github_release_download_version
    if github_release_download_version is defined
    else 'latest'
) | quote }}

TEMP_FILE=""
CHECKSUM_FILE=""
VERSION_TEMP_FILE=""
RESPONSE_HEADERS=""
LOCK_FILE={{ github_release_download_lock_file | quote }}

trusted_directory() {
    local path=$1 component current=""
    local -a components
    IFS=/ read -r -a components <<< "$path"
    for component in "${components[@]}"; do
        [[ -n "$component" ]] || continue
        current="${current}/${component}"
        [[ -d "$current" && ! -L "$current" ]] || return 1
        [[ "$(stat -c '%u' -- "$current")" == "0" ]] || return 1
        [[ "$(stat -c '%a' -- "$current")" =~ ^[0-7]?[0-7][0145][0145]$ ]] || return 1
    done
}

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" >> "$LOG_FILE"
}

cleanup() {
    [[ -z "$TEMP_FILE" ]] || rm -f -- "$TEMP_FILE"
    [[ -z "$CHECKSUM_FILE" ]] || rm -f -- "$CHECKSUM_FILE"
    [[ -z "$VERSION_TEMP_FILE" ]] || rm -f -- "$VERSION_TEMP_FILE"
    [[ -z "$RESPONSE_HEADERS" ]] || rm -f -- "$RESPONSE_HEADERS"
}
trap cleanup EXIT

DEST_DIR=$(dirname -- "$DEST")
LOG_DIR=$(dirname -- "$LOG_FILE")
if ! trusted_directory "$LOG_DIR" || [[ ! -f "$LOG_FILE" ]] || \
   [[ -L "$LOG_FILE" ]] || [[ "$(stat -c '%u' -- "$LOG_FILE")" != "0" ]] || \
   [[ ! "$(stat -c '%a' -- "$LOG_FILE")" =~ ^[0-7]?[0-7][0145][0145]$ ]]; then
    exit 1
fi
if ! trusted_directory "$DEST_DIR"; then
    log "ERROR: Destination directory is not trusted: ${DEST_DIR}"
    exit 1
fi

exec 9<>"$LOCK_FILE"
if ! flock --exclusive --nonblock 9; then
    log "INFO: Another release update is still running; skipping this cron run"
    exit 0
fi

if [[ -d "$DEST" ]]; then
    log "ERROR: Destination is a directory: ${DEST}"
    exit 1
fi

EXISTING_UID=""
EXISTING_GID=""
if [[ -f "$DEST" ]]; then
    EXISTING_UID=$(stat -c '%u' "$DEST")
    EXISTING_GID=$(stat -c '%g' "$DEST")
fi

# Get current version
CURRENT_VERSION=""
if [[ -f "$VERSION_FILE" ]]; then
    CURRENT_VERSION=$(cat "$VERSION_FILE")
fi

API_URL="${API_BASE}/${REPO}/releases/${RELEASE_PATH}"

# Get release info from GitHub API. Tokens are read from a root-only file and
# are never rendered into this script.
CURL_HEADERS=(-H "Accept: application/vnd.github+json")
ASSET_HEADERS=()
AUTHENTICATED=false
if [[ -r "$TOKEN_FILE" ]]; then
    GITHUB_TOKEN=$(<"$TOKEN_FILE")
    CURL_HEADERS+=(-H "Authorization: Bearer ${GITHUB_TOKEN}")
    ASSET_HEADERS=(-H "Accept: application/octet-stream" -H "Authorization: Bearer ${GITHUB_TOKEN}")
    AUTHENTICATED=true
fi
if $AUTHENTICATED; then
    RELEASE_INFO=$(curl -fsS --proto '=https,http' --max-redirs 0 \
        "${CURL_HEADERS[@]}" "$API_URL" 2>/dev/null) || {
        log "ERROR: Failed to fetch release info from GitHub API"
        exit 1
    }
else
    RELEASE_INFO=$(curl -fsSL --proto '=https,http' --proto-redir '=https' \
        "${CURL_HEADERS[@]}" "$API_URL" 2>/dev/null) || {
        log "ERROR: Failed to fetch release info from GitHub API"
        exit 1
    }
fi

download_asset() {
    local url=$1
    local output=$2
    local status redirect

    if ! $AUTHENTICATED; then
        curl -fsSL --proto '=https,http' --proto-redir '=https' \
            "${ASSET_HEADERS[@]}" -o "$output" "$url"
        return
    fi

    RESPONSE_HEADERS=$(mktemp -- "${DEST_DIR}/.${ASSET}.headers.XXXXXX")
    status=$(curl -fsS --proto '=https,http' --max-redirs 0 \
        "${ASSET_HEADERS[@]}" -D "$RESPONSE_HEADERS" -o "$output" \
        -w '%{http_code}' "$url") || return
    case "$status" in
        2*) ;;
        3*)
            redirect=$(awk '
                tolower($1) == "location:" {
                    sub(/^[^:]+:[ \t]*/, "")
                    sub(/\r$/, "")
                    location = $0
                }
                END { print location }
            ' "$RESPONSE_HEADERS")
            [[ "$redirect" =~ ^https:// ]] || return 1
            curl -fsSL --proto '=https' --proto-redir '=https' \
                -o "$output" "$redirect"
            ;;
        *) return 1 ;;
    esac
    rm -f -- "$RESPONSE_HEADERS"
    RESPONSE_HEADERS=""
}

if [[ -z "$RELEASE_INFO" ]]; then
    log "ERROR: Failed to fetch release info from GitHub API"
    exit 1
fi

# Extract version tag and download URL using jq for robust JSON parsing
LATEST_VERSION=$(echo "$RELEASE_INFO" | jq -r '.tag_name')
DOWNLOAD_URL=$(echo "$RELEASE_INFO" | jq -r \
    --arg asset "$ASSET" \
    --argjson authenticated "$AUTHENTICATED" \
    '.assets[] | select(.name == $asset) | if $authenticated then .url else .browser_download_url end')
DOWNLOAD_DIGEST=$(echo "$RELEASE_INFO" | jq -r \
    --arg asset "$ASSET" \
    '.assets[] | select(.name == $asset) | .digest // ""')
{% if github_release_download_checksum_asset is defined %}
CHECKSUM_URL=$(echo "$RELEASE_INFO" | jq -r \
    --arg asset {{ github_release_download_checksum_asset | quote }} \
    --argjson authenticated "$AUTHENTICATED" \
    '.assets[] | select(.name == $asset) | if $authenticated then .url else .browser_download_url end')
{% endif %}

if [[ -z "$LATEST_VERSION" ]] || [[ "$LATEST_VERSION" == "null" ]]; then
    log "ERROR: Could not determine latest version"
    exit 1
fi

if [[ -z "$DOWNLOAD_URL" ]] || [[ "$DOWNLOAD_URL" == "null" ]]; then
    log "ERROR: Could not find download URL for asset: ${ASSET}"
    exit 1
fi

if [[ ! "$DOWNLOAD_URL" =~ ^https:// ]] && \
   [[ ! "$DOWNLOAD_URL" =~ ^http://(127\.0\.0\.1|localhost)(:[0-9]+)?/ ]]; then
    log "ERROR: Refusing an insecure asset URL"
    exit 1
fi
if $AUTHENTICATED && [[ "$DOWNLOAD_URL" != "$API_ORIGIN"/* ]]; then
    log "ERROR: Refusing to send credentials to an asset URL on another origin"
    exit 1
fi
{% if github_release_download_checksum_asset is defined %}
if [[ ! "$CHECKSUM_URL" =~ ^https:// ]] && \
   [[ ! "$CHECKSUM_URL" =~ ^http://(127\.0\.0\.1|localhost)(:[0-9]+)?/ ]]; then
    log "ERROR: Refusing an insecure checksum URL"
    exit 1
fi
if $AUTHENTICATED && [[ "$CHECKSUM_URL" != "$API_ORIGIN"/* ]]; then
    log "ERROR: Refusing to send credentials to a checksum URL on another origin"
    exit 1
fi
{% endif %}

# Resolve the checksum before deciding that an installed file is current.
EXPECTED_CHECKSUM=""
{% if github_release_download_checksum is defined %}
EXPECTED_CHECKSUM={{ github_release_download_checksum | regex_replace('^sha256:', '') | lower | quote }}
{% elif github_release_download_checksum_asset is defined %}
CHECKSUM_FILE=$(mktemp -- "${DEST_DIR}/.${ASSET}.checksum.XXXXXX")
if ! download_asset "$CHECKSUM_URL" "$CHECKSUM_FILE"; then
    log "ERROR: Failed to download checksum asset"
    exit 1
fi
EXPECTED_CHECKSUM=$(awk -v asset="$ASSET" '$2 == asset || $2 == "*" asset {print tolower($1); exit}' "$CHECKSUM_FILE")
{% else %}
EXPECTED_CHECKSUM="${DOWNLOAD_DIGEST#*:}"
EXPECTED_CHECKSUM=${EXPECTED_CHECKSUM,,}
{% endif %}

if [[ -n "$EXPECTED_CHECKSUM" ]] && [[ ! "$EXPECTED_CHECKSUM" =~ ^[a-f0-9]{64}$ ]]; then
    log "ERROR: Invalid SHA-256 verification source for ${ASSET}"
    exit 1
fi
{% if not github_release_download_allow_unverified %}
if [[ -z "$EXPECTED_CHECKSUM" ]]; then
    log "ERROR: No valid SHA-256 verification source for ${ASSET}"
    exit 1
fi
{% endif %}

# Check both the release marker and installed file integrity.
if [[ -f "$DEST" ]] && [[ "$CURRENT_VERSION" == "$LATEST_VERSION" ]]; then
    if [[ -z "$EXPECTED_CHECKSUM" ]] || \
       [[ "$(sha256sum "$DEST" | awk '{print tolower($1)}')" == "$EXPECTED_CHECKSUM" ]]; then
        log "INFO: Already up to date (${CURRENT_VERSION})"
        exit 0
    fi
    log "WARNING: Installed ${ASSET} failed SHA-256 verification; replacing it"
fi

log "INFO: Updating from ${CURRENT_VERSION:-'not installed'} to ${LATEST_VERSION}"

# Create the download temporary file in the destination directory so rename is atomic.
TEMP_FILE=$(mktemp -- "${DEST_DIR}/.${ASSET}.XXXXXX")

# Download the file
if ! download_asset "$DOWNLOAD_URL" "$TEMP_FILE"; then
    log "ERROR: Failed to download ${DOWNLOAD_URL}"
    exit 1
fi

if [[ -n "$EXPECTED_CHECKSUM" ]]; then
ACTUAL_CHECKSUM=$(sha256sum "$TEMP_FILE" | awk '{print tolower($1)}')
if [[ "$ACTUAL_CHECKSUM" != "$EXPECTED_CHECKSUM" ]]; then
    log "ERROR: SHA-256 verification failed for ${ASSET}"
    exit 1
fi
fi

# Set ownership and mode before atomically replacing the destination.
{% if github_release_download_owner is defined %}
chown -- "$FILE_OWNER" "$TEMP_FILE"
{% else %}
if [[ -n "$EXISTING_UID" ]]; then
    chown -- "$EXISTING_UID" "$TEMP_FILE"
fi
{% endif %}
{% if github_release_download_group is defined %}
chgrp -- "$FILE_GROUP" "$TEMP_FILE"
{% else %}
if [[ -n "$EXISTING_GID" ]]; then
    chgrp -- "$EXISTING_GID" "$TEMP_FILE"
fi
{% endif %}
chmod -- "$FILE_MODE" "$TEMP_FILE"
mv -f -- "$TEMP_FILE" "$DEST"
TEMP_FILE=""

{% if github_release_download_post_update_command is defined %}
# Run post-update command
log "INFO: Running post-update command"
{{ github_release_download_post_update_command }}
{% endif %}

# Record activation only after any post-update command succeeds.
VERSION_TEMP_FILE=$(mktemp -- "${DEST_DIR}/.${ASSET}.ver.XXXXXX")
printf '%s\n' "$LATEST_VERSION" > "$VERSION_TEMP_FILE"
chmod -- 0644 "$VERSION_TEMP_FILE"
mv -f -- "$VERSION_TEMP_FILE" "$VERSION_FILE"
VERSION_TEMP_FILE=""
log "INFO: Successfully updated to ${LATEST_VERSION}"
