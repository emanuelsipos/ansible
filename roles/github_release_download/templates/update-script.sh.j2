#!/bin/bash
# Auto-generated by github_release_download Ansible role
# Downloads {{ github_release_download_asset }} from {{ github_release_download_repo }} if a newer version exists

set -euo pipefail

REPO="{{ github_release_download_repo }}"
ASSET="{{ github_release_download_asset }}"
DEST="{{ github_release_download_dest }}"
VERSION_FILE="{{ github_release_download_dest }}.ver"
FILE_MODE="{{ github_release_download_mode }}"
{% if github_release_download_owner is defined %}
FILE_OWNER="{{ github_release_download_owner }}"
{% endif %}
{% if github_release_download_group is defined %}
FILE_GROUP="{{ github_release_download_group }}"
{% endif %}
LOG_FILE="{{ github_release_download_cron_log_file }}"
TOKEN_FILE="{{ github_release_download_token_file }}"

EXISTING_UID=""
EXISTING_GID=""
if [[ -e "$DEST" ]]; then
    EXISTING_UID=$(stat -c '%u' "$DEST")
    EXISTING_GID=$(stat -c '%g' "$DEST")
fi

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" >> "$LOG_FILE"
}

# Get current version
CURRENT_VERSION=""
if [[ -f "$VERSION_FILE" ]]; then
    CURRENT_VERSION=$(cat "$VERSION_FILE")
fi

{% if github_release_download_version is defined %}
API_URL="{{ github_release_download_api_url }}/${REPO}/releases/tags/{{ github_release_download_version }}"
{% else %}
API_URL="{{ github_release_download_api_url }}/${REPO}/releases/latest"
{% endif %}

# Get release info from GitHub API. Tokens are read from a root-only file and
# are never rendered into this script.
CURL_HEADERS=(-H "Accept: application/vnd.github+json")
ASSET_HEADERS=()
AUTHENTICATED=false
if [[ -r "$TOKEN_FILE" ]]; then
    GITHUB_TOKEN=$(<"$TOKEN_FILE")
    CURL_HEADERS+=(-H "Authorization: Bearer ${GITHUB_TOKEN}")
    ASSET_HEADERS=(-H "Accept: application/octet-stream" -H "Authorization: Bearer ${GITHUB_TOKEN}")
    AUTHENTICATED=true
fi
RELEASE_INFO=$(curl -fsSL "${CURL_HEADERS[@]}" "$API_URL" 2>/dev/null) || {
    log "ERROR: Failed to fetch release info from GitHub API"
    exit 1
}

# Extract version tag and download URL using jq for robust JSON parsing
LATEST_VERSION=$(echo "$RELEASE_INFO" | jq -r '.tag_name')
DOWNLOAD_URL=$(echo "$RELEASE_INFO" | jq -r \
    --arg asset "$ASSET" \
    --argjson authenticated "$AUTHENTICATED" \
    '.assets[] | select(.name == $asset) | if $authenticated then .url else .browser_download_url end')
{% if github_release_download_checksum_asset is defined %}
CHECKSUM_URL=$(echo "$RELEASE_INFO" | jq -r \
    --arg asset "{{ github_release_download_checksum_asset }}" \
    --argjson authenticated "$AUTHENTICATED" \
    '.assets[] | select(.name == $asset) | if $authenticated then .url else .browser_download_url end')
{% endif %}

if [[ -z "$LATEST_VERSION" ]] || [[ "$LATEST_VERSION" == "null" ]]; then
    log "ERROR: Could not determine latest version"
    exit 1
fi

if [[ -z "$DOWNLOAD_URL" ]] || [[ "$DOWNLOAD_URL" == "null" ]]; then
    log "ERROR: Could not find download URL for asset: ${ASSET}"
    exit 1
fi

# Check if update is needed
if [[ -f "$DEST" ]] && [[ "$CURRENT_VERSION" == "$LATEST_VERSION" ]]; then
    log "INFO: Already up to date (${CURRENT_VERSION})"
    exit 0
fi

log "INFO: Updating from ${CURRENT_VERSION:-'not installed'} to ${LATEST_VERSION}"

# Create temp file for download
TEMP_FILE=$(mktemp)
trap 'rm -f "$TEMP_FILE"' EXIT

# Download the file
if ! curl -fsSL "${ASSET_HEADERS[@]}" -o "$TEMP_FILE" "$DOWNLOAD_URL"; then
    log "ERROR: Failed to download ${DOWNLOAD_URL}"
    exit 1
fi

{% if github_release_download_checksum is defined %}
EXPECTED_CHECKSUM="{{ github_release_download_checksum | regex_replace('^sha256:', '') }}"
ACTUAL_CHECKSUM=$(sha256sum "$TEMP_FILE" | awk '{print $1}')
if [[ "$ACTUAL_CHECKSUM" != "$EXPECTED_CHECKSUM" ]]; then
    log "ERROR: SHA-256 mismatch for ${ASSET}"
    exit 1
fi
{% elif github_release_download_checksum_asset is defined %}
CHECKSUM_FILE=$(mktemp)
trap 'rm -f "$TEMP_FILE" "$CHECKSUM_FILE"' EXIT
if ! curl -fsSL "${ASSET_HEADERS[@]}" -o "$CHECKSUM_FILE" "$CHECKSUM_URL"; then
    log "ERROR: Failed to download checksum asset"
    exit 1
fi
EXPECTED_CHECKSUM=$(awk -v asset="$ASSET" '$2 == asset || $2 == "*" asset {print $1; exit}' "$CHECKSUM_FILE")
ACTUAL_CHECKSUM=$(sha256sum "$TEMP_FILE" | awk '{print $1}')
if [[ ! "$EXPECTED_CHECKSUM" =~ ^[a-fA-F0-9]{64}$ ]] || \
   [[ "$ACTUAL_CHECKSUM" != "$EXPECTED_CHECKSUM" ]]; then
    log "ERROR: SHA-256 verification failed for ${ASSET}"
    exit 1
fi
{% endif %}

# Ensure destination directory exists
mkdir -p "$(dirname "$DEST")"

# Move to destination
mv -f "$TEMP_FILE" "$DEST"

# Set permissions
chmod "$FILE_MODE" "$DEST"

{% if github_release_download_owner is defined %}
chown "$FILE_OWNER" "$DEST"
{% else %}
if [[ -n "$EXISTING_UID" ]]; then
    chown "$EXISTING_UID" "$DEST"
fi
{% endif %}
{% if github_release_download_group is defined %}
chgrp "$FILE_GROUP" "$DEST"
{% else %}
if [[ -n "$EXISTING_GID" ]]; then
    chgrp "$EXISTING_GID" "$DEST"
fi
{% endif %}

# Write version file
echo "$LATEST_VERSION" > "$VERSION_FILE"

log "INFO: Successfully updated to ${LATEST_VERSION}"

{% if github_release_download_cron_post_update_command is defined %}
# Run post-update command
log "INFO: Running post-update command"
{{ github_release_download_cron_post_update_command }}
{% endif %}
